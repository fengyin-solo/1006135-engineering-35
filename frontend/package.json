{
  "name": "shield-tunnel-construction-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "repoKind": "frontend-only",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:seed && vue-tsc --noEmit && vite build",
